// ─── Credora — Prisma Schema ───────────────────────────────────────────────
// Phase 1: Member, KYC, Daily Dairy, Collections, Loans, Ledger
// NOTE: RD and FD are STRICTLY DISABLED — no models, no enums, no fields.
// All models are scoped by tenant_id for full multi-tenant isolation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserRole {
  MEMBER
  COLLECTOR
  LOAN_OFFICER
  APPROVER
  SUPER_ADMIN
}

enum KYCStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum DocType {
  IDENTITY
  ADDRESS
  SELFIE
  PAN
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LoanStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  DISBURSED
  ACTIVE
  CLOSED
  REJECTED
}

enum GuarantorConsentStatus {
  INVITED
  ACCEPTED
  DECLINED
}

enum SettlementStatus {
  PENDING
  SETTLED
  FAILED
}

enum EntryType {
  DEBIT
  CREDIT
}

// ─── Models ─────────────────────────────────────────────────────────────────

model Tenant {
  id              String       @id @default(uuid())
  legalName       String
  policyVersion   String       @default("1.0")
  status          TenantStatus @default(ACTIVE)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  users            User[]
  members          Member[]
  dailyPlans       DailyPlan[]
  loanApplications LoanApplication[]
  ledgerEntries    LedgerEntry[]

  @@map("tenants")
}

model User {
  id        String   @id @default(uuid())
  tenantId  String
  phone     String
  pinHash   String
  role      UserRole @default(MEMBER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant                Tenant                  @relation(fields: [tenantId], references: [id])
  member                Member?
  collectedTransactions CollectionTransaction[] @relation("CollectorTransactions")
  approvedLoans         LoanApplication[]       @relation("ApproverLoans")

  @@unique([tenantId, phone])
  @@map("users")
}

model Member {
  id          String    @id @default(uuid())
  tenantId    String
  userId      String    @unique
  memberNo    String
  profileData Json
  kycStatus   KYCStatus @default(PENDING)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  user             User              @relation(fields: [userId], references: [id])
  documents        MemberDocument[]
  consents         ConsentRecord[]
  enrollments      DailyEnrollment[]
  loanApplications LoanApplication[] @relation("BorrowerLoans")
  guaranteedLoans  Guarantor[]

  @@unique([tenantId, memberNo])
  @@map("members")
}

model MemberDocument {
  id                 String             @id @default(uuid())
  memberId           String
  tenantId           String
  docType            DocType
  fileUrl            String
  hashSignature      String
  fileSizeBytes      Int
  mimeType           String
  verificationStatus VerificationStatus @default(PENDING)
  rejectionReason    String?
  uploadedAt         DateTime           @default(now())
  verifiedAt         DateTime?

  member Member @relation(fields: [memberId], references: [id])

  @@map("member_documents")
}

model ConsentRecord {
  id            String   @id @default(uuid())
  memberId      String
  tenantId      String
  purpose       String
  noticeVersion String
  ipAddress     String
  userAgent     String?
  timestamp     DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id])

  @@map("consent_records")
}

model DailyPlan {
  id           String   @id @default(uuid())
  tenantId     String
  planName     String
  dailyAmount  Decimal  @db.Decimal(12, 2)
  totalDays    Int      @default(100)
  maturityDays Int      @default(100)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  enrollments DailyEnrollment[]

  @@map("daily_plans")
}

model DailyEnrollment {
  id              String   @id @default(uuid())
  tenantId        String
  memberId        String
  planId          String
  collectorId     String
  startDate       DateTime
  expectedEndDate DateTime
  currentDay      Int      @default(0)
  totalDeposited  Decimal  @db.Decimal(12, 2) @default(0)
  isCompleted     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  member       Member                  @relation(fields: [memberId], references: [id])
  plan         DailyPlan               @relation(fields: [planId], references: [id])
  transactions CollectionTransaction[]

  @@map("daily_enrollments")
}

model CollectionTransaction {
  id               String           @id @default(uuid())
  receiptNo        String           @unique
  enrollmentId     String
  tenantId         String
  dueDate          DateTime
  amount           Decimal          @db.Decimal(12, 2)
  collectorId      String
  idempotencyKey   String           @unique
  settlementStatus SettlementStatus @default(PENDING)
  notes            String?
  collectedAt      DateTime         @default(now())

  enrollment    DailyEnrollment @relation(fields: [enrollmentId], references: [id])
  collector     User            @relation("CollectorTransactions", fields: [collectorId], references: [id])
  ledgerEntries LedgerEntry[]

  @@map("collection_transactions")
}

model LoanApplication {
  id                   String     @id @default(uuid())
  applicationNo        String     @unique
  tenantId             String
  memberId             String
  approverId           String?
  loanPurpose          String
  requestedAmount      Decimal    @db.Decimal(12, 2)
  approvedAmount       Decimal?   @db.Decimal(12, 2)
  interestRate         Decimal?   @db.Decimal(5, 4)
  tenureMonths         Int?
  status               LoanStatus @default(DRAFT)
  decisionReason       String?
  keyFactStatement     Json?
  digitalSignatureHash String?
  submittedAt          DateTime?
  decidedAt            DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  member      Member       @relation("BorrowerLoans", fields: [memberId], references: [id])
  approver    User?        @relation("ApproverLoans", fields: [approverId], references: [id])
  guarantors  Guarantor[]
  loanAccount LoanAccount?

  @@map("loan_applications")
}

model LoanAccount {
  id                 String   @id @default(uuid())
  applicationId      String   @unique
  tenantId           String
  principalAmount    Decimal  @db.Decimal(12, 2)
  outstandingBalance Decimal  @db.Decimal(12, 2)
  nextDueDate        DateTime
  repaymentSchedule  Json
  disbursedAt        DateTime @default(now())
  closedAt           DateTime?

  application   LoanApplication @relation(fields: [applicationId], references: [id])
  ledgerEntries LedgerEntry[]

  @@map("loan_accounts")
}

model Guarantor {
  id             String                 @id @default(uuid())
  applicationId  String
  memberId       String
  tenantId       String
  consentStatus  GuarantorConsentStatus @default(INVITED)
  liabilityTerms Json
  invitedAt      DateTime               @default(now())
  respondedAt    DateTime?

  application LoanApplication @relation(fields: [applicationId], references: [id])
  member      Member          @relation(fields: [memberId], references: [id])

  @@map("guarantors")
}

model LedgerEntry {
  id            String    @id @default(uuid())
  tenantId      String
  transactionId String?
  loanAccountId String?
  entryType     EntryType
  accountCode   String
  amount        Decimal   @db.Decimal(12, 2)
  description   String
  referenceNo   String
  entryDate     DateTime  @default(now())

  tenant      Tenant                 @relation(fields: [tenantId], references: [id])
  transaction CollectionTransaction? @relation(fields: [transactionId], references: [id])
  loanAccount LoanAccount?           @relation(fields: [loanAccountId], references: [id])

  @@map("ledger_entries")
}
